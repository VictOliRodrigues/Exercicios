# ===== Aplicação =====
NODE_ENV=production
PORT=3000
# Número de proxies na frente do app (no Coolify: 1)
TRUST_PROXY=1

# ===== Banco (MySQL) =====
DATABASE_URL=mysql://simulados_app:TROQUE_AQUI@mysql:3306/simulados

# ===== Sessão =====
# Gere com: npm run keys:generate
SESSION_SECRET=
SESSION_IDLE_HOURS=8
# Opcional. Padrão: true em produção. Só use false para testar a imagem localmente sem HTTPS.
# COOKIE_SECURE=false

# ===== Criptografia =====
# 32 bytes em base64. Gere com: npm run keys:generate
# GUARDE UMA CÓPIA FORA DO SERVIDOR: sem ela, os dados são irrecuperáveis.
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# ===== Arquivos =====
STORAGE_PATH=/app/storage
MAX_UPLOAD_MB=1

# ===== Admin (seed) =====
# O e-mail é o login do admin. A troca de senha é obrigatória no primeiro login.
# Depois que o admin existir, ADMIN_PASSWORD pode ser removida.
ADMIN_EMAIL=
ADMIN_NAME=Administrador
# Mínimo de 12 caracteres
ADMIN_PASSWORD=

# ===== Login =====
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MINUTES=15
FORGOT_MAX_PER_HOUR=5

# ===== Só para desenvolvimento local (docker-compose e testes) =====
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=simulados
MYSQL_USER=simulados_app
MYSQL_PASSWORD=
MYSQL_HOST_PORT=3307
TEST_DATABASE_URL=mysql://root:SENHA_ROOT@127.0.0.1:3307/simulados_test
