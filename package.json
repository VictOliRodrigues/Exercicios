{
  "name": "simulados",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "admin:reset-password": "node dist/scripts/admin-reset-password.js"
  },
  "dependencies": {
    "argon2": "0.45.1",
    "csrf-sync": "4.2.1",
    "drizzle-orm": "0.45.3",
    "ejs": "6.0.1",
    "express": "5.2.1",
    "express-mysql-session": "3.0.3",
    "express-rate-limit": "8.7.0",
    "express-session": "1.19.0",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "mysql2": "3.24.5",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "uuid": "14.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/express-mysql-session": "3.0.8",
    "@types/express-session": "1.19.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/multer": "2.3.0",
    "@types/node": "24.19.0",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
