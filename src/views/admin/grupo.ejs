<%- include('../partials/head', { pageWidth: 800 }) %>
<nav class="breadcrumb" aria-label="Você está em">
  <a href="/admin/grupos">Grupos</a><span class="breadcrumb-separator" aria-hidden="true">›</span><span aria-current="page"><%= group.name %></span>
</nav>
<div class="page-header">
  <h1><%= group.name %></h1>
</div>

<div class="stack stack-tight">
  <section class="card">
    <h2 class="section-heading">Nome do grupo</h2>
    <%- include('../partials/errors', { errors: error ? [error] : [] }) %>
    <form method="post" action="/admin/grupos/<%= group.id %>" class="inline-fields">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <label class="field">
        <span>Nome</span>
        <input type="text" name="nome" value="<%= nome %>" maxlength="80" autocomplete="off" required>
      </label>
      <button type="submit" class="button button-secondary">Renomear</button>
    </form>
  </section>

  <section class="card">
    <h2 class="section-heading">Membros (<%= members.length %>)</h2>
    <% if (!members.length) { %>
      <p class="empty-note">Ninguém participa deste grupo ainda.</p>
    <% } else { %>
      <ul class="row-list">
        <% members.forEach(function (member) { %>
          <li<% if (!member.active) { %> class="is-inactive"<% } %>>
            <div class="row-list-main">
              <div class="row-list-title">
                <span><%= member.name %></span>
                <% if (!member.active) { %><span class="badge badge-muted">Desativado</span><% } %>
              </div>
              <div class="row-list-meta"><%= member.email %></div>
            </div>
            <form method="post" action="/admin/grupos/<%= group.id %>/membros/<%= member.id %>/remover" class="inline-form" data-confirm-title="Remover <%= member.name %> do grupo?" data-confirm="Os simulados que essa pessoa compartilhou aqui saem do grupo, e ela perde o acesso aos simulados do grupo que nunca fez." data-confirm-button="Remover do grupo">
              <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
              <button type="submit" class="button button-small button-danger-outline">Remover</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="card">
    <h2 class="section-heading">Adicionar membros</h2>
    <p class="card-lead">Usuários ativos que ainda não estão no grupo.</p>
    <% if (!candidates.length) { %>
      <p class="empty-note">Todos os usuários ativos já participam deste grupo.</p>
    <% } else { %>
      <form method="post" action="/admin/grupos/<%= group.id %>/membros" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <fieldset>
          <legend class="sr-only">Usuários ativos fora do grupo</legend>
          <ul class="row-list">
            <% candidates.forEach(function (candidate) { %>
              <li>
                <label class="row-list-check">
                  <input type="checkbox" name="usuarios" value="<%= candidate.id %>">
                  <span class="row-list-main">
                    <span class="row-list-title"><%= candidate.name %></span>
                    <span class="row-list-meta"><%= candidate.email %></span>
                  </span>
                </label>
              </li>
            <% }) %>
          </ul>
        </fieldset>
        <div class="actions">
          <button type="submit" class="button button-primary">Adicionar selecionados</button>
        </div>
      </form>
    <% } %>
  </section>

  <section class="card danger-card" aria-labelledby="area-de-perigo">
    <h2 class="danger-card-head" id="area-de-perigo">Área de perigo</h2>
    <div class="danger-card-body">
      <div class="danger-card-text">
        <h3>Excluir grupo</h3>
        <p>O grupo é apagado e os membros perdem o acesso aos simulados que estavam compartilhados com ele, menos os que já fizeram. Os usuários e os simulados não são apagados, e os resultados ficam guardados. Esta ação não pode ser desfeita.</p>
      </div>
      <form method="post" action="/admin/grupos/<%= group.id %>/excluir" class="inline-form" data-confirm-title="Excluir o grupo <%= group.name %>?" data-confirm="Os membros perdem o acesso aos simulados compartilhados com ele, menos os que já fizeram. Esta ação não pode ser desfeita." data-confirm-button="Excluir grupo">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button type="submit" class="button button-danger">Excluir grupo</button>
      </form>
    </div>
  </section>
</div>
<%- include('../partials/foot') %>
