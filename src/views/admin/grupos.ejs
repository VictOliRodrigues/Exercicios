<%- include('../partials/head', { pageWidth: 960 }) %>
<div class="page-header">
  <div>
    <h1>Grupos de estudo</h1>
    <p class="page-lead">Os grupos reúnem usuários que estudam juntos. Ao compartilhar um simulado com um grupo, ele fica disponível de uma vez para todos os membros. Cada pessoa faz os simulados e vê os resultados só para si.</p>
  </div>
</div>

<div class="stack">
  <section class="card card-compact">
    <h2 class="card-title">Criar grupo</h2>
    <%- include('../partials/errors', { errors: error ? [error] : [] }) %>
    <form method="post" action="/admin/grupos" class="inline-fields">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <label class="field">
        <span>Nome do grupo</span>
        <input type="text" name="nome" value="<%= nome %>" maxlength="80" placeholder="Ex.: Turma de sábado" autocomplete="off" required>
      </label>
      <button type="submit" class="button button-primary">Criar grupo</button>
    </form>
  </section>

  <section class="card table-card">
    <% if (!groups.length) { %>
      <div class="empty-state">
        <h2>Nenhum grupo ainda</h2>
        <p class="muted">Crie um grupo e depois adicione os membros.</p>
      </div>
    <% } else { %>
      <table class="table table-lg responsive-table">
        <thead>
          <tr>
            <th scope="col">Grupo</th>
            <th scope="col" class="numeric">Membros</th>
            <th scope="col" class="numeric">Simulados compartilhados</th>
          </tr>
        </thead>
        <tbody>
          <% groups.forEach(function (group) { %>
            <tr>
              <td data-label="Grupo"><a class="table-link" href="/admin/grupos/<%= group.id %>"><%= group.name %></a></td>
              <td data-label="Membros" class="numeric"><%= group.memberCount %></td>
              <td data-label="Simulados" class="numeric<%= group.bankCount ? '' : ' muted' %>"><%= group.bankCount %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>
<%- include('../partials/foot') %>
