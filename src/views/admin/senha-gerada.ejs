<%- include('../partials/head', { layout: 'centered' }) %>
<section class="card narrow-card">
  <h1><%= heading %></h1>
  <p class="muted">Envie estes dados para <strong><%= name %></strong> por fora do sistema (WhatsApp, e-mail etc.).</p>

  <dl class="data-list">
    <dt>E-mail (login)</dt>
    <dd><%= email %></dd>
  </dl>

  <div class="alert alert-warning" role="status">
    Copie agora: esta senha não será exibida de novo. A troca é obrigatória no primeiro acesso.
  </div>

  <p class="hint">Senha temporária</p>
  <code class="secret" id="senha-gerada"><%= password %></code>
  <div class="actions">
    <button type="button" class="button button-primary" data-copy="senha-gerada">Copiar senha</button>
    <a class="button button-secondary" href="/admin/usuarios">Voltar para usuários</a>
  </div>

</section>
<%- include('../partials/foot') %>
