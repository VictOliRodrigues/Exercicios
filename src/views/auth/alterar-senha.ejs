<%- include('../partials/head') %>
<section class="card form-card page-card">
  <h1><%= forced ? 'Defina uma nova senha' : 'Alterar senha' %></h1>

  <% if (forced) { %>
    <div class="alert alert-warning alert-large alert-with-icon" role="status">
      <%- include('../partials/alert-icon', { icon: 'warning' }) %>
      <span>Por segurança, você precisa trocar a senha antes de continuar usando o sistema.</span>
    </div>
  <% } %>

  <%- include('../partials/errors', { errors }) %>

  <form method="post" action="/alterar-senha" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label class="field">
      <span>Senha atual</span>
      <input type="password" name="senhaAtual" autocomplete="current-password" maxlength="200" required autofocus>
    </label>
    <label class="field">
      <span>Nova senha</span>
      <input type="password" name="novaSenha" autocomplete="new-password" minlength="10" maxlength="200" required>
      <small class="hint">Pelo menos 10 caracteres.</small>
    </label>
    <label class="field">
      <span>Confirmar nova senha</span>
      <input type="password" name="confirmacao" autocomplete="new-password" minlength="10" maxlength="200" required>
    </label>
    <div class="actions form-actions">
      <button type="submit" class="button button-primary">Salvar nova senha</button>
      <% if (!forced) { %>
        <a href="/">Cancelar</a>
      <% } %>
    </div>
  </form>
</section>
<%- include('../partials/foot') %>
