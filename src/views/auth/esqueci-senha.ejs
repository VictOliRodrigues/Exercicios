<%- include('../partials/head', { layout: 'centered' }) %>
<div class="auth">
  <%- include('../partials/auth-brand') %>
  <section class="card form-card">
    <h1>Esqueci minha senha</h1>

    <% if (sent) { %>
      <div class="alert alert-info alert-large alert-with-icon" role="status">
        <%- include('../partials/alert-icon', { icon: 'check' }) %>
        <span><strong>Pedido registrado.</strong> Se o e-mail estiver cadastrado, o administrador vai redefinir sua senha e passar a nova senha provisória para você.</span>
      </div>
    <% } else { %>
      <p class="form-lead">
        Informe seu e-mail e envie o pedido. O administrador do sistema vai redefinir sua senha e passar a nova senha provisória para você.
      </p>

      <% if (error) { %>
        <div class="alert alert-error alert-with-icon" role="alert">
          <%- include('../partials/alert-icon') %>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="post" action="/esqueci-senha" class="form">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <label class="field">
          <span>E-mail</span>
          <input type="email" name="email" value="<%= email %>" placeholder="nome@empresa.com.br" autocomplete="username" maxlength="254" required autofocus>
        </label>
        <button type="submit" class="button button-primary button-block">Enviar pedido</button>
      </form>
    <% } %>

    <p class="card-footer"><a href="/login">Voltar ao login</a></p>
  </section>
</div>
<%- include('../partials/foot') %>
