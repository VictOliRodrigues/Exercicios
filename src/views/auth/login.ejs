<%- include('../partials/head', { layout: 'centered' }) %>
<section class="card narrow-card">
  <div class="card-brand">
    <%- include('../partials/logo') %>
    <h1><%= appName %></h1>
  </div>
  <p class="muted">Entre com o e-mail e a senha que o administrador enviou para você.</p>

  <% if (error) { %>
    <div class="alert alert-error" role="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/login" class="form">
    <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
    <label class="field">
      <span>E-mail</span>
      <input type="email" name="email" value="<%= email %>" autocomplete="username" maxlength="254" required autofocus>
    </label>
    <label class="field">
      <span>Senha</span>
      <input type="password" name="senha" autocomplete="current-password" maxlength="200" required>
    </label>
    <button type="submit" class="button button-primary button-block">Entrar</button>
  </form>

  <p class="card-footer"><a href="/esqueci-senha">Esqueci minha senha</a></p>
</section>
<%- include('../partials/foot') %>
