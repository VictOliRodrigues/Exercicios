<%- include('../partials/head') %>
<%
  let origin;
  if (isOwner) {
    origin = sharedGroups.length
      ? 'Compartilhado com ' + formatList(sharedGroups.map(function (group) { return group.name; }))
      : 'Privado';
  } else if (viaGroups.length) {
    origin = 'Enviado por ' + ownerName + ' em ' + formatList(viaGroups.map(function (group) { return group.name; }));
  } else {
    origin = 'Recebido de ' + ownerName;
  }
  const sharedIds = sharedGroups.map(function (group) { return group.id; });
%>
<a class="back-link" href="/">← Painel</a>
<div class="page-header">
  <h1><%= title %></h1>
  <div class="subtitle item-meta">
    <span><%= plural(bank.questionCount, 'questão', 'questões') %></span>
    <span class="badge <%= isOwner && !sharedGroups.length ? 'badge-muted' : 'badge-info' %>"><%= origin %></span>
    <span>Importado em <%= formatDate(bank.createdAt) %></span>
  </div>
</div>

<div class="stack">
  <% if (importResult) { %>
    <div class="alert alert-success" role="status">
      <%= plural(importResult.questionCount, 'questão importada', 'questões importadas') %>.
    </div>
    <% if (importResult.warnings.length) { %>
      <div class="alert alert-warning" role="status">
        <p class="alert-title">Avisos da importação</p>
        <ul>
          <% importResult.warnings.forEach(function (warning) { %><li><%= warning %></li><% }) %>
        </ul>
      </div>
    <% } %>
  <% } %>

  <section class="card" aria-labelledby="fazer-simulado">
    <h2 id="fazer-simulado">Fazer o simulado</h2>
    <form method="post" action="/bancos/<%= bank.id %>/simulados" class="form form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <label class="field">
        <span>Quantidade de questões</span>
        <input type="number" name="quantidade" min="1" max="<%= bank.questionCount %>" step="1" inputmode="numeric" placeholder="Todas (<%= bank.questionCount %>)">
        <small class="hint">Em branco, todas. Um número menor sorteia as questões.</small>
      </label>
      <label class="field">
        <span>Tempo limite (minutos)</span>
        <input type="number" name="minutos" min="1" max="<%= maxMinutes %>" step="1" inputmode="numeric" placeholder="Sem limite">
        <small class="hint">Em branco, sem limite. Quando o tempo acaba, a prova é finalizada sozinha.</small>
      </label>
      <div class="actions">
        <button type="submit" class="button button-primary">Iniciar novo simulado</button>
      </div>
      <p class="hint full">O cronômetro começa ao clicar em Iniciar. As questões e as alternativas são embaralhadas a cada tentativa, 10 questões por página.</p>
    </form>
  </section>

  <section class="card<% if (attempts.length) { %> table-card<% } %>" aria-labelledby="suas-tentativas">
    <% if (!attempts.length) { %>
      <h2 id="suas-tentativas">Suas tentativas</h2>
      <p class="empty-note">Você ainda não fez este simulado. Suas tentativas e notas aparecem aqui.</p>
    <% } else { %>
      <h2 id="suas-tentativas" class="table-card-title">Suas tentativas</h2>
      <table class="table responsive-table">
        <thead>
          <tr>
            <th scope="col">Início</th>
            <th scope="col">Nota</th>
            <th scope="col">Tempo</th>
            <th scope="col"><span class="sr-only">Ações</span></th>
          </tr>
        </thead>
        <tbody>
          <% attempts.forEach(function (attempt) { %>
            <tr>
              <td data-label="Início" class="nowrap"><%= formatDateTime(attempt.startedAt) %></td>
              <% if (attempt.status === 'in_progress') { %>
                <td data-label="Nota">
                  <div>
                    <span class="badge badge-warning">Em andamento</span>
                    <span class="cell-note"><%= attempt.answered %>/<%= attempt.totalQuestions %> respondidas</span>
                  </div>
                </td>
                <td data-label="Tempo">—</td>
                <td class="row-actions">
                  <div class="row-actions-list">
                    <a href="/simulados/<%= attempt.id %>">Continuar</a>
                    <form method="post" action="/simulados/<%= attempt.id %>/descartar" class="inline-form" data-confirm="Descartar esta tentativa? As respostas dela serão apagadas.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                      <button type="submit" class="link-button link-danger">Descartar</button>
                    </form>
                  </div>
                </td>
              <% } else { %>
                <td data-label="Nota">
                  <div>
                    <strong><%= formatScore(attempt.score) %></strong>
                    <span class="cell-note"><%= plural(attempt.totalQuestions, 'questão', 'questões') %></span>
                  </div>
                </td>
                <td data-label="Tempo">
                  <div>
                    <%= formatDuration(attempt.durationSeconds) %>
                    <% if (attempt.finishReason === 'time') { %><span class="cell-note">Tempo esgotado</span><% } %>
                  </div>
                </td>
                <td class="row-actions">
                  <div class="row-actions-list">
                    <a href="/simulados/<%= attempt.id %>/relatorio">Ver relatório</a>
                  </div>
                </td>
              <% } %>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <% if (isOwner) { %>
    <section class="card">
      <h2>Compartilhar com</h2>
      <% if (!myGroups.length) { %>
        <p class="empty-note">Você não participa de nenhum grupo de estudo, então o simulado é privado. Quem cria os grupos é o administrador.</p>
      <% } else { %>
        <form method="post" action="/bancos/<%= bank.id %>/compartilhamento" class="form">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <fieldset>
            <legend class="sr-only">Grupos</legend>
            <ul class="checkbox-list">
              <% myGroups.forEach(function (group) { %>
                <li>
                  <label>
                    <input type="checkbox" name="grupos" value="<%= group.id %>"<% if (sharedIds.includes(group.id)) { %> checked<% } %>>
                    <span><%= group.name %></span>
                  </label>
                </li>
              <% }) %>
            </ul>
          </fieldset>
          <p class="hint">Sem nenhum grupo marcado, o simulado fica privado. Quem já fez continua com ele mesmo que o compartilhamento acabe.</p>
          <div class="actions">
            <button type="submit" class="button button-primary">Salvar compartilhamento</button>
          </div>
        </form>
      <% } %>
    </section>

    <section class="card danger-zone">
      <h2>Excluir simulado</h2>
      <p class="muted">O simulado some do seu painel e dos grupos. Quem já fez continua com ele, e os resultados de todos são preservados.</p>
      <form method="post" action="/bancos/<%= bank.id %>/excluir" class="inline-form" data-confirm="Excluir o simulado <%= title %>? Esta ação não pode ser desfeita.">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button type="submit" class="button button-danger">Excluir simulado</button>
      </form>
    </section>
  <% } %>
</div>
<%- include('../partials/foot') %>
