<%- include('../partials/head', { pageWidth: 880 }) %>
<%
  let origin;
  if (isOwner) {
    origin = sharedGroups.length
      ? 'Compartilhado com ' + formatList(sharedGroups.map(function (group) { return group.name; }))
      : 'Privado';
  } else if (viaGroups.length) {
    origin = 'Enviado por ' + ownerName + ' em ' + formatList(viaGroups.map(function (group) { return group.name; }));
  } else {
    origin = 'Recebido de ' + ownerName;
  }
  const originClass = !isOwner && !viaGroups.length ? 'badge-teal' : isOwner && sharedGroups.length ? 'badge-info' : 'badge-muted';
  const sharedIds = sharedGroups.map(function (group) { return group.id; });
  const sampleCount = Math.min(20, bank.questionCount);
%>
<nav class="breadcrumb" aria-label="Você está em">
  <a href="/">Painel</a><span class="breadcrumb-separator" aria-hidden="true">›</span><span aria-current="page"><%= title %></span>
</nav>
<div class="page-header">
  <div>
    <h1 class="title-lg"><%= title %></h1>
    <div class="page-meta">
      <strong><%= plural(bank.questionCount, 'questão', 'questões') %></strong>
      <span class="badge <%= originClass %>"><%= origin %></span>
      <span>Importado em <%= formatDate(bank.createdAt) %></span>
    </div>
  </div>
</div>

<div class="stack stack-tight">
  <% if (importResult) { %>
    <section class="card result-card" role="status" aria-labelledby="importacao">
      <h2 class="result-card-head" id="importacao">
        <%- include('../partials/icon', { iconName: 'check' }) %>
        <%= plural(importResult.questionCount, 'questão importada', 'questões importadas') %>
      </h2>
      <% if (importResult.warnings.length) { %>
        <div class="result-card-body">
          <p><%= plural(importResult.warnings.length, 'aviso', 'avisos') %> — o simulado foi importado mesmo assim:</p>
          <ul class="warning-list">
            <% importResult.warnings.forEach(function (warning) { %>
              <% const where = /^Questão \d+:/.exec(warning); %>
              <li>
                <%- include('../partials/alert-icon', { icon: 'warning' }) %>
                <span><% if (where) { %><strong><%= where[0] %></strong><%= warning.slice(where[0].length) %><% } else { %><%= warning %><% } %></span>
              </li>
            <% }) %>
          </ul>
        </div>
      <% } %>
    </section>
  <% } %>

  <section class="card" aria-labelledby="suas-tentativas">
    <h2 class="section-heading section-heading-spaced" id="suas-tentativas">Suas tentativas</h2>
    <% if (!attempts.length) { %>
      <p class="empty-note">Você ainda não fez este simulado. Escolha as opções abaixo e inicie.</p>
    <% } else { %>
      <div class="table-box">
        <table class="table responsive-table">
          <thead>
            <tr>
              <th scope="col">Data</th>
              <th scope="col">Nota</th>
              <th scope="col">Tempo</th>
              <th scope="col"><span class="sr-only">Ações</span></th>
            </tr>
          </thead>
          <tbody>
            <% attempts.forEach(function (attempt) { %>
              <tr>
                <td data-label="Data" class="nowrap"><%= formatDateTime(attempt.startedAt) %></td>
                <% if (attempt.status === 'in_progress') { %>
                  <td data-label="Nota"><span class="cell-inline"><span class="tag tag-info">Em andamento</span><span class="muted">· <%= attempt.answered %> de <%= attempt.totalQuestions %> respondidas</span></span></td>
                  <td data-label="Tempo">—</td>
                  <td class="row-actions">
                    <div class="row-actions-inline row-actions-inline-tight">
                      <a class="button button-small button-primary" href="/simulados/<%= attempt.id %>">Continuar</a>
                      <form method="post" action="/simulados/<%= attempt.id %>/descartar" class="inline-form" data-confirm="Descartar esta tentativa? As respostas dela serão apagadas.">
                        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
                        <button type="submit" class="button button-small button-danger-outline">Descartar</button>
                      </form>
                    </div>
                  </td>
                <% } else { %>
                  <td data-label="Nota" class="nowrap"><span><strong><%= formatScore(attempt.score) %></strong><span class="muted"> · <%= attempt.correctCount ?? 0 %> de <%= attempt.totalQuestions %></span></span></td>
                  <td data-label="Tempo">
                    <div>
                      <%= formatDuration(attempt.durationSeconds) %>
                      <% if (attempt.finishReason === 'time') { %><span class="cell-note">Tempo esgotado</span><% } %>
                    </div>
                  </td>
                  <td class="row-actions cell-end"><a class="link-strong" href="/simulados/<%= attempt.id %>/relatorio">Ver relatório</a></td>
                <% } %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </section>

  <section class="card" aria-labelledby="novo-simulado">
    <h2 class="section-heading" id="novo-simulado">Novo simulado</h2>
    <form method="post" action="/bancos/<%= bank.id %>/simulados" class="start-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <fieldset class="choice-group">
        <legend>Quantidade de questões</legend>
        <div class="choice-list">
          <label class="choice">
            <input type="radio" name="modoQuantidade" value="todas" checked>
            Todas (<%= bank.questionCount %>)
          </label>
          <div class="choice">
            <input type="radio" name="modoQuantidade" value="sortear" id="modo-sortear">
            <label for="modo-sortear">Sortear</label>
            <input class="number-input" type="number" name="quantidade" value="<%= sampleCount %>" min="1" max="<%= bank.questionCount %>" step="1" inputmode="numeric" aria-label="Quantas questões sortear" data-checks="modo-sortear">
            <span class="choice-unit">questões</span>
          </div>
        </div>
      </fieldset>
      <fieldset class="choice-group">
        <legend>Tempo limite</legend>
        <div class="choice-list">
          <label class="choice">
            <input type="radio" name="modoTempo" value="sem-limite" checked>
            Sem limite
          </label>
          <div class="choice">
            <input type="radio" name="modoTempo" value="limite" id="modo-limite">
            <label for="modo-limite">Limite de</label>
            <input class="number-input" type="number" name="minutos" value="60" min="1" max="<%= maxMinutes %>" step="1" inputmode="numeric" aria-label="Tempo limite em minutos" aria-describedby="tempo-dica" data-checks="modo-limite">
            <span class="choice-unit">minutos</span>
          </div>
        </div>
        <p class="hint" id="tempo-dica">Quando o tempo acaba, a prova é finalizada sozinha.</p>
      </fieldset>
      <button type="submit" class="button button-primary">Iniciar novo simulado</button>
    </form>
  </section>

  <% if (isOwner) { %>
    <section class="card" aria-labelledby="compartilhar">
      <h2 class="section-heading" id="compartilhar">Compartilhar com</h2>
      <% if (!myGroups.length) { %>
        <p class="empty-note">Você não participa de nenhum grupo de estudo, então o simulado é privado. Quem cria os grupos é o administrador.</p>
      <% } else { %>
        <p class="card-lead">Os membros dos grupos marcados veem este simulado no painel deles. Sem nenhum grupo marcado, ele fica privado. Quem já fez continua com ele mesmo que o compartilhamento acabe.</p>
        <form method="post" action="/bancos/<%= bank.id %>/compartilhamento" class="form share-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <fieldset>
            <legend class="sr-only">Grupos</legend>
            <ul class="check-list">
              <% myGroups.forEach(function (group) { %>
                <li>
                  <label>
                    <input type="checkbox" name="grupos" value="<%= group.id %>"<% if (sharedIds.includes(group.id)) { %> checked<% } %>>
                    <span><%= group.name %></span>
                  </label>
                </li>
              <% }) %>
            </ul>
          </fieldset>
          <div class="actions">
            <button type="submit" class="button button-secondary">Salvar compartilhamento</button>
          </div>
        </form>
      <% } %>
    </section>

    <section class="card danger-card" aria-labelledby="area-de-perigo">
      <h2 class="danger-card-head" id="area-de-perigo">Área de perigo</h2>
      <div class="danger-card-body">
        <div class="danger-card-text">
          <h3>Excluir simulado</h3>
          <p>O simulado some do seu painel e do painel de quem o recebeu por grupo. Quem já fez continua com ele, e os resultados de todos ficam guardados. Esta ação não pode ser desfeita.</p>
        </div>
        <form method="post" action="/bancos/<%= bank.id %>/excluir" class="inline-form" data-confirm="Excluir o simulado <%= title %>? Esta ação não pode ser desfeita.">
          <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
          <button type="submit" class="button button-danger">Excluir simulado</button>
        </form>
      </div>
    </section>
  <% } %>
</div>
<%- include('../partials/foot') %>
