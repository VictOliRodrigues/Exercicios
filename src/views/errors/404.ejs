<%- include('../partials/head', { layout: 'centered' }) %>
<section class="error-page">
  <% if (!locals.currentUser) { %><%- include('../partials/auth-brand') %><% } %>
  <p class="error-code" aria-hidden="true">404</p>
  <h1 class="error-title">Página não encontrada</h1>
  <p class="error-text">O endereço pode estar errado, ou a página foi removida.</p>
  <% if (locals.currentUser) { %>
    <a class="button button-primary" href="/">Voltar ao painel</a>
  <% } else { %>
    <a class="button button-primary" href="/login">Ir para o login</a>
  <% } %>
</section>
<%- include('../partials/foot') %>
