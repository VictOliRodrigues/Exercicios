<%- include('partials/head') %>
<div class="page-header">
  <h1>Olá, <%= firstName %></h1>
  <a class="button button-primary" href="/bancos/importar">Importar simulado</a>
</div>

<div class="stack">
  <% if (attempts.inProgress.length) { %>
    <section class="card" aria-labelledby="em-andamento">
      <div class="section-title">
        <h2 id="em-andamento">Em andamento</h2>
      </div>
      <ul class="item-list">
        <% attempts.inProgress.forEach(function (attempt) { %>
          <li>
            <div class="item-main">
              <a class="item-title" href="/simulados/<%= attempt.id %>"><%= attempt.title %></a>
              <div class="item-meta">
                <span>Iniciado em <%= formatDateTime(attempt.startedAt) %></span>
                <span><%= attempt.answered %>/<%= attempt.totalQuestions %> respondidas</span>
              </div>
            </div>
            <a class="button button-secondary button-small" href="/simulados/<%= attempt.id %>">Continuar</a>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <section class="card" aria-labelledby="meus-simulados">
    <div class="section-title">
      <h2 id="meus-simulados">Meus simulados</h2>
    </div>
    <% if (!panel.mine.length && !panel.received.length) { %>
      <p class="empty-note">
        Você ainda não importou nenhum simulado. <a href="/bancos/importar">Importe um arquivo .md</a> gerado no ChatGPT, ou o modelo de exemplo para testar.
      </p>
    <% } else { %>
      <ul class="item-list">
        <% panel.mine.forEach(function (bank) { %>
          <%- include('partials/bank-item', {
            bank,
            label: bank.sharedWith.length ? 'Compartilhado com ' + formatList(bank.sharedWith) : 'Privado',
            badgeClass: bank.sharedWith.length ? 'badge-info' : 'badge-muted',
          }) %>
        <% }) %>
        <% panel.received.forEach(function (bank) { %>
          <%- include('partials/bank-item', {
            bank,
            label: 'Recebido de ' + bank.ownerName,
            badgeClass: 'badge-muted',
          }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <% panel.groups.forEach(function (group) { %>
    <section class="card" aria-label="Grupo <%= group.name %>">
      <div class="section-title">
        <h2><%= group.name %></h2>
        <span class="hint">Grupo de estudo</span>
      </div>
      <% if (!group.banks.length) { %>
        <p class="empty-note">Ninguém compartilhou simulados neste grupo ainda.</p>
      <% } else { %>
        <ul class="item-list">
          <% group.banks.forEach(function (bank) { %>
            <%- include('partials/bank-item', {
              bank,
              label: 'Enviado por ' + bank.ownerName,
              badgeClass: 'badge-info',
            }) %>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>

  <section class="card<% if (attempts.history.length) { %> table-card<% } %>" aria-labelledby="historico">
    <% if (!attempts.history.length) { %>
      <h2 id="historico">Histórico</h2>
      <p class="empty-note">Os simulados que você finalizar aparecem aqui, com a nota e o tempo.</p>
    <% } else { %>
      <h2 id="historico" class="table-card-title">Histórico</h2>
      <table class="table responsive-table">
        <thead>
          <tr>
            <th scope="col">Data</th>
            <th scope="col">Simulado</th>
            <th scope="col">Nota</th>
            <th scope="col">Tempo</th>
            <th scope="col"><span class="sr-only">Relatório</span></th>
          </tr>
        </thead>
        <tbody>
          <% attempts.history.forEach(function (attempt) { %>
            <tr>
              <td data-label="Data" class="nowrap"><%= formatDateTime(attempt.finishedAt) %></td>
              <td data-label="Simulado" class="break-anywhere"><%= attempt.title %></td>
              <td data-label="Nota"><strong><%= formatScore(attempt.score) %></strong></td>
              <td data-label="Tempo">
                <div>
                  <%= formatDuration(attempt.durationSeconds) %>
                  <% if (attempt.finishReason === 'time') { %><span class="cell-note">Tempo esgotado</span><% } %>
                </div>
              </td>
              <td class="row-actions"><a href="/simulados/<%= attempt.id %>/relatorio">Ver relatório</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>
<%- include('partials/foot') %>
