<%- include('partials/head', { pageWidth: 1040 }) %>
<div class="page-header">
  <h1 class="title-lg">Olá, <%= firstName %></h1>
  <a class="button button-primary" href="/bancos/importar">
    <%- include('partials/icon', { iconName: 'download', iconClass: 'button-icon' }) %>
    Importar simulado
  </a>
</div>

<div class="stack">
  <% if (attempts.inProgress.length) { %>
    <section class="card list-card" aria-labelledby="em-andamento">
      <div class="list-card-header">
        <h2 id="em-andamento">Em andamento</h2>
        <span class="list-card-count"><%= plural(attempts.inProgress.length, 'tentativa', 'tentativas') %></span>
      </div>
      <ul class="list-card-rows">
        <% attempts.inProgress.forEach(function (attempt) { %>
          <% const progressLabel = attempt.answered + ' de ' + attempt.totalQuestions + ' respondidas'; %>
          <li>
            <div class="list-card-main">
              <a class="list-card-title" href="/simulados/<%= attempt.id %>"><%= attempt.title %></a>
              <div class="list-card-meta">Iniciado em <%= formatDateTimeAt(attempt.startedAt) %> · <%= progressLabel %></div>
            </div>
            <div class="list-card-side">
              <progress class="progress" value="<%= attempt.answered %>" max="<%= attempt.totalQuestions %>" aria-label="<%= progressLabel %>"></progress>
              <a class="link-strong" href="/simulados/<%= attempt.id %>">Continuar →</a>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <section class="card list-card" aria-labelledby="meus-simulados">
    <div class="list-card-header">
      <h2 id="meus-simulados">Meus simulados</h2>
      <% const myCount = panel.mine.length + panel.received.length; %>
      <% if (myCount) { %><span class="list-card-count"><%= plural(myCount, 'simulado', 'simulados') %></span><% } %>
    </div>
    <% if (!myCount) { %>
      <p class="list-card-empty">
        Você ainda não importou nenhum simulado. <a href="/bancos/importar">Importe um arquivo .md</a> gerado no ChatGPT, ou o modelo de exemplo para testar.
      </p>
    <% } else { %>
      <ul class="list-card-rows">
        <% panel.mine.forEach(function (bank) { %>
          <%- include('partials/bank-item', {
            bank,
            label: bank.sharedWith.length ? 'Compartilhado com ' + formatList(bank.sharedWith) : 'Privado',
            badgeClass: bank.sharedWith.length ? 'badge-info' : 'badge-muted',
            badgeIcon: bank.sharedWith.length ? 'users' : 'lock',
          }) %>
        <% }) %>
        <% panel.received.forEach(function (bank) { %>
          <%- include('partials/bank-item', {
            bank,
            label: 'Recebido de ' + bank.ownerName,
            badgeClass: 'badge-teal',
            badgeIcon: 'inbox',
          }) %>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <% panel.groups.forEach(function (group) { %>
    <section class="card list-card" aria-label="Grupo <%= group.name %>">
      <div class="list-card-header">
        <h2><%= group.name %></h2>
        <span class="list-card-count">Grupo<% if (group.banks.length) { %> · <%= plural(group.banks.length, 'simulado dos outros membros', 'simulados dos outros membros') %><% } %></span>
      </div>
      <% if (!group.banks.length) { %>
        <p class="list-card-empty">Nenhum simulado enviado pelos outros membros deste grupo ainda.</p>
      <% } else { %>
        <ul class="list-card-rows">
          <% group.banks.forEach(function (bank) { %>
            <%- include('partials/bank-item', {
              bank,
              label: 'Enviado por ' + bank.ownerName,
              badgeClass: 'badge-muted badge-plain',
            }) %>
          <% }) %>
        </ul>
      <% } %>
    </section>
  <% }) %>

  <section class="card list-card" aria-labelledby="historico">
    <div class="list-card-header">
      <h2 id="historico">Histórico</h2>
      <% if (attempts.history.length) { %><span class="list-card-count"><%= plural(attempts.history.length, 'tentativa finalizada', 'tentativas finalizadas') %></span><% } %>
    </div>
    <% if (!attempts.history.length) { %>
      <p class="list-card-empty">Os simulados que você finalizar aparecem aqui, com a nota e o tempo.</p>
    <% } else { %>
      <table class="table responsive-table">
        <thead>
          <tr>
            <th scope="col">Data</th>
            <th scope="col">Simulado</th>
            <th scope="col">Nota</th>
            <th scope="col">Tempo</th>
            <th scope="col"><span class="sr-only">Relatório</span></th>
          </tr>
        </thead>
        <tbody>
          <% attempts.history.forEach(function (attempt) { %>
            <tr>
              <td data-label="Data" class="nowrap"><%= formatDateTime(attempt.finishedAt) %></td>
              <td data-label="Simulado" class="break-anywhere"><%= attempt.title %></td>
              <td data-label="Nota" class="nowrap">
                <span><strong><%= formatScore(attempt.score) %></strong><span class="muted"> · <%= attempt.correctCount ?? 0 %> de <%= attempt.totalQuestions %></span></span>
              </td>
              <td data-label="Tempo">
                <div>
                  <%= formatDuration(attempt.durationSeconds) %>
                  <% if (attempt.finishReason === 'time') { %><span class="cell-note">Tempo esgotado</span><% } %>
                </div>
              </td>
              <td class="row-actions cell-end"><a class="link-strong" href="/simulados/<%= attempt.id %>/relatorio">Ver relatório</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>
<%- include('partials/foot') %>
