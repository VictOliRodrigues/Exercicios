<li>
  <div class="list-card-main">
    <a class="list-card-title" href="/bancos/<%= bank.id %>"><%= bank.title %></a>
    <div class="list-card-meta"><%= plural(bank.questionCount, 'questão', 'questões') %></div>
  </div>
  <span class="badge <%= badgeClass %>"><% if (locals.badgeIcon) { %><%- include('icon', { iconName: badgeIcon }) %><% } %><%= label %></span>
  <% if (locals.removeFrom) { %>
    <form method="post" action="/pastas/<%= removeFrom %>/simulados/<%= bank.id %>/remover" class="inline-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
      <button type="submit" class="button button-small button-secondary" aria-label="Tirar <%= bank.title %> da pasta">Tirar da pasta</button>
    </form>
  <% } %>
</li>
