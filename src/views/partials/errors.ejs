<% if (errors && errors.length) { %>
  <div class="alert alert-error alert-with-icon" role="alert">
    <%- include('alert-icon') %>
    <% if (errors.length === 1) { %>
      <span><%= errors[0] %></span>
    <% } else { %>
      <ul>
        <% errors.forEach(function (message) { %><li><%= message %></li><% }) %>
      </ul>
    <% } %>
  </div>
<% } %>
