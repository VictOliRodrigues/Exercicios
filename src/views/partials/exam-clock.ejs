<%#
  Barra fixa da prova. O prova.js parte dos segundos informados pelo servidor e, quando o tempo
  limite zera, envia o formulário indicado em data-finish-form para data-finish-url.
%>
<div class="exam-bar" role="region" aria-label="Andamento da prova">
  <div class="exam-bar-inner"
       data-exam-clock
       data-elapsed="<%= clock.elapsed %>"
       <% if (clock.remaining !== null) { %>data-remaining="<%= clock.remaining %>"<% } %>
       data-finish-form="<%= finishForm %>"
       data-finish-url="/simulados/<%= attempt.id %>/finalizar">
    <h1 class="exam-title"><%= title %></h1>
    <dl class="exam-stats">
      <div class="exam-stat">
        <dt class="exam-stat-label">Tempo decorrido</dt>
        <dd class="exam-clock" data-clock-elapsed><%= formatClock(clock.elapsed) %></dd>
      </div>
      <% if (clock.remaining !== null) { %>
        <div class="exam-stat exam-remaining<% if (clock.remaining <= 300) { %> is-urgent<% } %>" data-clock-remaining-box>
          <dt class="exam-stat-label">Tempo restante</dt>
          <dd class="exam-clock" data-clock-remaining><%= formatClock(clock.remaining) %></dd>
        </div>
      <% } %>
      <div class="exam-stat">
        <dt class="exam-stat-label">Página</dt>
        <dd class="exam-stat-value"><%= exam.page %> de <%= exam.pageCount %></dd>
      </div>
      <div class="exam-stat">
        <dt class="exam-stat-label">Respondidas</dt>
        <dd class="exam-stat-value"><span data-answered-count><%= exam.answered %></span>/<%= exam.total %></dd>
      </div>
    </dl>
  </div>
</div>
