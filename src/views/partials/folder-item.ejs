<li class="folder-row">
  <a class="folder-link" href="/pastas/<%= folder.id %>">
    <span class="folder-icon"><%- include('icon', { iconName: 'folder' }) %></span>
    <span class="list-card-main">
      <span class="folder-name"><%= folder.name %></span>
      <span class="list-card-meta"><%= folder.bankCount ? plural(folder.bankCount, 'simulado', 'simulados') : 'Pasta vazia' %></span>
    </span>
    <%- include('icon', { iconName: 'chevron-right', iconClass: 'folder-chevron' }) %>
  </a>
</li>
