<!doctype html>
<html lang="pt-BR"<% if (locals.theme) { %> data-theme="<%= theme %>"<% } %>>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= appName %></title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/app.css">
  <script src="/js/app.js" defer></script>
  <% (locals.scripts || []).forEach(function (src) { %>
  <script src="<%= src %>" defer></script>
  <% }) %>
</head>
<body>
<% if (locals.currentUser) { %>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/">
        <%- include('logo') %>
        <span><%= appName %></span>
      </a>
      <% if (!currentUser.mustChangePassword) { %>
        <%
          const navPath = locals.currentPath || '';
          const links = currentUser.role === 'admin'
            ? [['/admin/usuarios', 'Usuários', navPath.startsWith('/admin/usuarios')],
               ['/admin/grupos', 'Grupos', navPath.startsWith('/admin/grupos')]]
            : [['/', 'Painel', navPath === '/'],
               ['/bancos/importar', 'Importar', navPath === '/bancos/importar']];
        %>
        <nav class="nav" aria-label="Principal">
          <% links.forEach(function (link) { %>
            <a href="<%= link[0] %>"<% if (link[2]) { %> aria-current="page"<% } %>><%= link[1] %></a>
          <% }) %>
        </nav>
      <% } %>
      <div class="user-menu">
        <%- include('theme-toggle', { toggleClass: 'topbar-icon-button' }) %>
        <span class="user-name"><%= currentUser.name %></span>
        <% if (!currentUser.mustChangePassword) { %>
          <a href="/alterar-senha"<% if (locals.currentPath === '/alterar-senha') { %> aria-current="page"<% } %>>Alterar senha</a>
        <% } %>
        <form method="post" action="/logout" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken ? csrfToken() : '' %>">
          <button type="submit" class="topbar-button">Sair</button>
        </form>
      </div>
    </div>
  </header>
<% } else { %>
  <%- include('theme-toggle', { toggleClass: 'theme-toggle-floating' }) %>
<% } %>
<main class="<%= locals.layout === 'centered' ? 'centered' : 'page' + (locals.pageWidth ? ' page-' + pageWidth : '') %>">
<% (locals.flash || []).forEach(function (item) { %>
  <div class="alert alert-<%= item.type %>" role="status"><%= item.message %></div>
<% }) %>
