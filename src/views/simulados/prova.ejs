<%- include('../partials/head', { pageWidth: 1200, scripts: ['/js/prova.js'] }) %>
<%- include('../partials/exam-clock', { finishForm: 'form-prova' }) %>
<% const lastPage = exam.page === exam.pageCount; %>

<form id="form-prova" method="post" action="/simulados/<%= attempt.id %>/pagina" class="exam-layout"
      data-answer-url="/api/simulados/<%= attempt.id %>/respostas/" data-page="<%= exam.page %>"<% if (blankModal) { %> inert<% } %>>
  <input type="hidden" name="_csrf" value="<%= csrfToken() %>">

  <aside class="exam-side">
    <details class="card exam-map" open data-exam-map>
      <summary>
        Mapa de questões
        <%- include('../partials/icon', { iconName: 'chevron-up', iconClass: 'exam-map-chevron' }) %>
      </summary>
      <div class="map-grid">
        <% exam.map.forEach(function (item) { %>
          <button type="submit" name="ir" value="<%= item.number %>"
                  class="map-item<% if (item.answered) { %> is-answered<% } %><% if (item.page === exam.page) { %> is-current-page<% } %>"
                  data-map-number="<%= item.number %>" data-map-page="<%= item.page %>"
                  aria-label="Questão <%= item.number %>, <%= item.answered ? 'respondida' : 'em branco' %>"><%= item.number %></button>
        <% }) %>
      </div>
      <p class="map-legend">
        <span><span class="map-swatch is-answered" aria-hidden="true"></span>Respondida</span>
        <span><span class="map-swatch" aria-hidden="true"></span>Em branco</span>
        <span><span class="map-swatch is-current-page" aria-hidden="true"></span>Nesta página</span>
      </p>
    </details>
  </aside>

  <div class="exam-questions">
    <% exam.questions.forEach(function (question) { %>
      <article class="card question" id="questao-<%= question.number %>">
        <div class="question-head">
          <h2 class="question-number">Questão <%= question.number %></h2>
          <span class="question-saved" data-saved-for="<%= question.number %>"<% if (question.selectedLetter === null) { %> hidden<% } %>>✓ Resposta salva</span>
        </div>
        <div class="rich-text question-statement"><%- question.statementHtml %></div>
        <fieldset class="options">
          <legend class="sr-only">Alternativas da questão <%= question.number %></legend>
          <% question.options.forEach(function (html, letter) { %>
            <label class="option">
              <input type="radio" name="q<%= question.number %>" value="<%= letter %>"<% if (question.selectedLetter === letter) { %> checked<% } %>>
              <span class="option-letter"><%= letterLabel(letter) %></span>
              <span class="option-text rich-text"><%- html %></span>
            </label>
          <% }) %>
        </fieldset>
      </article>
    <% }) %>

    <div class="exam-nav">
      <% if (exam.page > 1) { %>
        <button type="submit" name="destino" value="<%= exam.page - 1 %>" class="button button-secondary">← Anterior</button>
      <% } %>
      <% if (!lastPage) { %>
        <button type="submit" name="destino" value="<%= exam.page + 1 %>" class="button button-primary">Próxima →</button>
      <% } else { %>
        <button type="submit" formaction="/simulados/<%= attempt.id %>/finalizar" class="button button-primary" data-finish-button>Finalizar</button>
      <% } %>
    </div>
    <p class="hint save-status" data-save-status role="status" aria-live="polite"></p>
  </div>
</form>

<% if (lastPage && !blankModal) { %>
  <%# Com tudo respondido, o prova.js abre esta janela antes de finalizar. Sem JS, finaliza direto. %>
  <dialog class="modal modal-confirm" id="confirmar-finalizar" aria-labelledby="finalizar-titulo">
    <div class="modal-header">
      <h2 class="modal-title" id="finalizar-titulo">Finalizar o simulado?</h2>
    </div>
    <div class="modal-body">
      <p class="modal-text">Você respondeu todas as <%= exam.total %> questões. Depois de finalizar, não é possível mudar as respostas.</p>
    </div>
    <div class="modal-actions">
      <button type="button" class="button button-secondary" data-close-dialog>Não, revisar respostas</button>
      <button type="submit" form="form-prova" formaction="/simulados/<%= attempt.id %>/finalizar" name="confirmar" value="1" class="button button-primary">Sim, finalizar</button>
    </div>
  </dialog>
<% } %>

<% if (blankModal) { %>
  <% const shown = blankModal.blanks.slice(0, 10).join(', ') + (blankModal.blanks.length > 10 ? '…' : ''); %>
  <dialog class="modal modal-confirm" open aria-labelledby="em-branco-titulo" data-close-href="/simulados/<%= attempt.id %>?pagina=<%= exam.page %>">
    <div class="modal-header">
      <span class="modal-status modal-status-warning"><%- include('../partials/alert-icon', { icon: 'warning' }) %></span>
      <h2 class="modal-title" id="em-branco-titulo">Há questões em branco</h2>
    </div>
    <div class="modal-body">
      <p class="modal-text">Você deixou <strong><%= plural(blankModal.blanks.length, 'questão em branco', 'questões em branco') %></strong> (<%= shown %>). Questões em branco contam como erradas. Deseja finalizar mesmo assim?</p>
      <p class="hint">Ao responder, as questões em branco vão para uma página nova no final da prova. Os números não mudam e o cronômetro continua correndo. <a href="/simulados/<%= attempt.id %>?pagina=<%= exam.page %>">Voltar à prova sem mudar a ordem</a>.</p>
    </div>
    <div class="modal-actions">
      <form method="post" action="/simulados/<%= attempt.id %>/reorganizar" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <button type="submit" class="button button-secondary">Não, responder as em branco</button>
      </form>
      <form method="post" action="/simulados/<%= attempt.id %>/finalizar" class="inline-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken() %>">
        <input type="hidden" name="confirmar" value="1">
        <button type="submit" class="button button-primary">Sim, finalizar</button>
      </form>
    </div>
  </dialog>
<% } %>
<%- include('../partials/foot') %>
