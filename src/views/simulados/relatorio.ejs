<%- include('../partials/head', { pageWidth: 920 }) %>
<%
  const byTime = attempt.finishReason === 'time';
  const wrongOnly = attempt.wrongCount - attempt.blankCount;
%>
<nav class="breadcrumb" aria-label="Você está em">
  <a href="/">Painel</a><span class="breadcrumb-separator" aria-hidden="true">›</span><% if (canOpenBank) { %><a href="/bancos/<%= attempt.bankId %>"><%= bankTitle %></a><% } else { %><span><%= bankTitle %></span><% } %><span class="breadcrumb-separator" aria-hidden="true">›</span><span aria-current="page">Relatório</span>
</nav>
<div class="page-header">
  <div>
    <h1 class="title-lg">Relatório</h1>
    <div class="page-meta page-meta-lg">
      <span class="meta-title"><%= bankTitle %></span>
      <span>Finalizado em <%= formatDateTimeAt(attempt.finishedAt) %></span>
      <% if (byTime) { %>
        <span class="badge badge-danger">Encerrado por tempo esgotado</span>
      <% } else { %>
        <span class="badge badge-muted">Finalizado por você</span>
      <% } %>
    </div>
  </div>
</div>

<div class="stack stack-tight">
  <section class="card result-summary" aria-labelledby="resultado">
    <h2 id="resultado" class="sr-only">Resultado</h2>
    <div class="score-panel">
      <span class="stat-label">Nota</span>
      <div class="score-line">
        <span class="stat-value"><%= formatScore(attempt.score) %></span>
        <span class="score-scale">/ 10</span>
      </div>
      <p class="score-percent"><%= formatPercent(attempt.correctCount, attempt.totalQuestions) %> de acerto</p>
      <progress class="progress score-bar" value="<%= attempt.correctCount %>" max="<%= attempt.totalQuestions || 1 %>" aria-hidden="true"></progress>
    </div>
    <dl class="result-stats">
      <div class="stat stat-right">
        <dt class="stat-label">Acertos</dt>
        <dd><span class="stat-value"><%= attempt.correctCount %></span></dd>
      </div>
      <div class="stat stat-wrong">
        <dt class="stat-label">Erros</dt>
        <dd>
          <span class="stat-value"><%= attempt.wrongCount %></span>
          <% if (attempt.blankCount) { %><span class="stat-note">sendo <%= attempt.blankCount %> em branco</span><% } %>
        </dd>
      </div>
      <div class="stat">
        <dt class="stat-label">Total</dt>
        <dd>
          <span class="stat-value"><%= attempt.totalQuestions %></span>
          <span class="stat-note">questões</span>
        </dd>
      </div>
      <div class="stat stat-wide">
        <dt class="stat-label">Tempo total</dt>
        <dd>
          <span class="stat-clock"><%= formatClock(attempt.durationSeconds ?? 0) %></span>
          <span class="stat-note"><%= attempt.timeLimitSeconds ? 'Tempo limite: ' + formatClock(attempt.timeLimitSeconds) : 'Sem tempo limite' %></span>
        </dd>
      </div>
    </dl>
  </section>

  <section class="card list-card review-card" aria-labelledby="erradas">
    <div class="list-card-header">
      <h2 id="erradas">Questões erradas e em branco</h2>
      <% if (items.length) { %>
        <span class="list-card-count"><%= plural(items.length, 'questão', 'questões') %></span>
        <p class="list-card-note">
          <%= wrongOnly ? plural(wrongOnly, 'errada', 'erradas') : '' %><%= wrongOnly && attempt.blankCount ? ' e ' : '' %><%= attempt.blankCount ? plural(attempt.blankCount, 'em branco', 'em branco') : '' %>, na ordem dos números. As letras são as que você viu nesta tentativa.
        </p>
      <% } %>
    </div>
    <% if (!items.length) { %>
      <p class="list-card-empty">Você acertou todas as questões.</p>
    <% } else { %>
      <ol class="review-list">
        <% items.forEach(function (item) { %>
          <li class="review-item" id="questao-<%= item.number %>">
            <h3 class="question-number">Questão <%= item.number %></h3>
            <div class="rich-text question-statement"><%- item.statementHtml %></div>
            <% if (item.selected) { %>
              <div class="answer answer-wrong">
                <%- include('../partials/icon', { iconName: 'x' }) %>
                <span class="answer-text rich-text"><strong class="answer-label">Sua resposta:</strong> <%= letterLabel(item.selected.letter) %>) <%- item.selected.html %></span>
              </div>
            <% } else { %>
              <div class="answer answer-wrong answer-blank">
                <%- include('../partials/icon', { iconName: 'circle-dashed' }) %>
                <span class="answer-text">Em branco</span>
              </div>
            <% } %>
            <div class="answer answer-right">
              <%- include('../partials/icon', { iconName: 'check' }) %>
              <span class="answer-text rich-text"><strong class="answer-label">Correta:</strong> <%= letterLabel(item.correct.letter) %>) <%- item.correct.html %></span>
            </div>
          </li>
        <% }) %>
      </ol>
    <% } %>
  </section>
</div>
<%- include('../partials/foot') %>
